# Copy to .env and change secrets before any shared deployment.
POSTGRES_USER=ouroboros
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=ouroboros

MINIO_ROOT_USER=ouroboros
MINIO_ROOT_PASSWORD=change-me-minio
S3_BUCKET=ouroboros-scans

JWT_SECRET=change-me-long-random-string
APP_ENV=dev            # dev echoes OTP codes in the API response; use "prod" otherwise
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Inference service: "mock" returns clearly-flagged demo detections until real
# weights are placed in ./models; "yolo" loads ./models/detector.pt.
INFERENCE_MODE=mock
INSTALL_ML=0           # set 1 to bake ultralytics + torch (CPU) into the inference image

WEB_PORT=8080
API_PORT=8000
