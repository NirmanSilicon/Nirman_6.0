# VidyutSync (EcoSync-Industrial) Configuration

# Server & Runtime Mode
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
ORCHESTRATOR_MODE=shadow # shadow | live_pilot
TICK_INTERVAL_SECONDS=15

# TimescaleDB / PostgreSQL
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres
TIMESCALE_DB=vidyutsync
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vidyutsync

# MQTT Broker (Eclipse Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=vidyutsync-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# Industrial OPC UA Bridge / Simulated PLC
OPCUA_SERVER_ENDPOINT=opc.tcp://localhost:4840/freeopcua/server/
OPCUA_NAMESPACE=urn:vidyutsync:plant:mfg01
OPCUA_SIMULATOR_PORT=4840

# Optional Kafka Bus
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=vidyutsync.

# LLM Base Models & Fine-Tuning
BASE_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
GRID_CARBON_MODEL_PATH=models/weights/grid_carbon_lora
MICROGRID_STORAGE_MODEL_PATH=models/weights/microgrid_storage_lora
PRODUCTION_SCHEDULING_MODEL_PATH=models/weights/production_scheduling_lora
ERGONOMICS_SHIFT_MODEL_PATH=models/weights/ergonomics_shift_lora
LLM_DEVICE=cpu # cpu | cuda
USE_MOCK_LLM=true # set true for fast rule-guided mock inference without weights
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.2

# Reward Function Weights
REWARD_WEIGHT_CARBON=0.35
REWARD_WEIGHT_COST=0.30
REWARD_WEIGHT_SCHEDULE=0.25
REWARD_WEIGHT_WORKER=0.10

# Hard Safety Guardrail Thresholds
BESS_MIN_SOC_FLOOR_PCT=30.0 # 30% absolute reserve floor
BESS_MAX_CHARGE_RATE_KW=250.0
BESS_MAX_DISCHARGE_RATE_KW=250.0
WORKER_MAX_NOISE_DAY_DB=85.0
WORKER_MAX_NOISE_NIGHT_DB=70.0
WORKER_MIN_COMFORT_TEMP_C=18.0
WORKER_MAX_COMFORT_TEMP_C=26.0
MAX_GRID_DRAW_KW=1200.0
MPS_TARDINESS_PENALTY_RATE=50.0 # heavy penalty per minute of tardiness
