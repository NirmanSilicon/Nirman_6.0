# App
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://parksmart:CHANGE_ME@db:5432/parksmart
POSTGRES_USER=parksmart
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=parksmart

# Auth
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14

# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_USERNAME=backend
MQTT_PASSWORD=CHANGE_ME
MQTT_TLS=true
MQTT_CA_FILE=/certs/ca.crt

# Data quality
STALE_AFTER_S=120
UNAVAILABLE_AFTER_S=600
MAX_FUTURE_SKEW_S=30
RATE_LIMIT_PER_MIN=120
CORS_ORIGINS=http://localhost:5173

# Forecast
MIN_HISTORY_DAYS=14
AGG_INTERVAL_MIN=15

# Privacy
VIDEO_RETENTION_DAYS=0
MAP_PROVIDER=osm

# Display
FREE_BAY_GREEN_THRESHOLD=0.30
