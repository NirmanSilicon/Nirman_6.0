# Local development values only. Replace both with independent random values.
AGENT_X_OPERATOR_TOKEN=local-operator-change-me
AGENT_X_SANDBOX_TOKEN=local-sandbox-change-me
AGENT_X_PROFILE=sandbox
AGENT_X_DATABASE=data/product.sqlite3
AGENT_X_PRODUCT_URL=http://127.0.0.1:8000
AGENT_X_DASHBOARD_URL=http://localhost:8000
# Optional Docker host ports; change these if another service already uses them.
AGENT_X_PRODUCT_PORT=8000
AGENT_X_SANDBOX_PORT=8080
