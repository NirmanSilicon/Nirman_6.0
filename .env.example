# SANGAM backend configuration (Person 5 module)
# Copy this file to ".env" and adjust as needed. Never commit real secrets.

# Port the server listens on.
PORT=8080

# Public base URL used to build QR join links.
# Leave blank to auto-detect from the incoming request (works for localhost and LAN).
# Set this when you deploy behind a domain or tunnel, e.g. https://sangam.example.com
PUBLIC_BASE_URL=

# How long a communication session stays joinable, in minutes.
SESSION_TTL_MINUTES=60

# How long a volunteer assistance request is kept, in minutes.
ASSIST_TTL_MINUTES=180

# Max participants allowed in one communication session.
MAX_PARTICIPANTS=8

# WebSocket safety limits.
MSG_RATE_WINDOW_MS=10000
MSG_RATE_MAX=40
MAX_TEXT_LEN=1000

# Extra allowed browser origins for the WebSocket, comma-separated.
# Same-origin and localhost are always allowed; add tunnel / production hosts here.
# Example: ALLOWED_ORIGINS=https://sangam.example.com,https://pr-7.preview.example.com
ALLOWED_ORIGINS=

# ---- Translation (optional; the app says "not set up" and never fakes a translation when empty) ----
# Provider: "libretranslate" or "google". Leave blank to disable translation.
TRANSLATE_PROVIDER=
# LibreTranslate: base URL of your instance, and its API key if it needs one (sent in a header, never to the browser).
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Google Cloud Translation v2: API key (sent in a header) and optional endpoint override.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_URL=
# Provider call timeout in milliseconds.
TRANSLATE_TIMEOUT_MS=8000

# ---- Live voice (WebRTC) ----
# JSON array of ICE servers handed to the browser. STUN alone works on many networks; add a TURN server
# for strict NATs. Example: [{"urls":"stun:stun.l.google.com:19302"}]
# Do not put long-lived secrets here: these values are sent to participants' browsers.
ICE_SERVERS=

# ---- Accounts (registration, roles, onboarding, connections, interpreter verification) ----
# Accounts, sessions, connections, notifications and learning progress are stored in ONE JSON file (single server process only;
# see server/db.js). Delete the file to delete every account. Keep it private: it holds password hashes (scrypt) and profile data.
# Default if blank: ./data/sangam-data.json (the data/ folder is not served to browsers).
DATA_FILE=
# Comma-separated emails that may review interpreter verification requests. Leave blank to have no administrator.
# Being listed here only matters once that person has registered and verified their email.
ADMIN_EMAILS=
# SANGAM has NO email service. Verification and password-reset links are therefore shown on screen, labelled "NOT emailed",
# whenever DEV_TOKENS is on. Default: ON unless NODE_ENV=production. That is fine on your own computer; on a shared server it
# would let anyone verify any address, so set NODE_ENV=production (or DEV_TOKENS=0) there. Until a mail sender is added
# (not included), a production deployment also needs REQUIRE_EMAIL_VERIFICATION=0, because nobody could receive a link.
DEV_TOKENS=
# Set to 0 to let people use the account area without verifying their email. Default: verification required.
REQUIRE_EMAIL_VERIFICATION=
# Test-only: multiplies the per-IP registration/login limits so automated tests can create many accounts. Never set in production.
ACCOUNT_RATE_MULT=
