{
  "openapi": "3.1.0",
  "info": {
    "title": "ParkSMART Backend API",
    "summary": "AI-Powered Smart Parking and Commercial Loading-Zone Management Platform",
    "description": "Backend platform specification for Bhubaneswar deployment, providing real-time telemetry, predictive parking availability via Monte Carlo simulations, automated loading bay reservations with PostgreSQL exclusion constraints, and multi-role operations.",
    "version": "1.0.0",
    "contact": {
      "name": "ParkSMART Engineering Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Development / Docker Compose"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "System Health & Liveness Probes"
    },
    {
      "name": "auth",
      "description": "Authentication & Token Lifecycle Management"
    },
    {
      "name": "users",
      "description": "User Management & Profiles"
    },
    {
      "name": "businesses",
      "description": "Commercial Business Entities & Fleet Accounts"
    },
    {
      "name": "zones",
      "description": "Parking Zones, Telemetry & Facilities"
    },
    {
      "name": "bays",
      "description": "Individual Parking and Loading Bays"
    },
    {
      "name": "parking-reservations",
      "description": "Parking Bay Reservations and Lifecycle State Machine"
    },
    {
      "name": "loading",
      "description": "Commercial Loading Dock Management & 30-Min Slot Booking"
    },
    {
      "name": "availability",
      "description": "Arrival-Time Availability Probability & Monte Carlo Engine"
    },
    {
      "name": "recommendations",
      "description": "Multi-Zone Multi-Criteria Smart Parking Recommendations"
    },
    {
      "name": "notifications",
      "description": "In-App Alerts and Push Notifications"
    },
    {
      "name": "admin",
      "description": "Municipal & System Administration and Approvals"
    },
    {
      "name": "reports",
      "description": "Municipal Operational Analytics & Revenue Reports"
    },
    {
      "name": "audit",
      "description": "Append-Only Audit Log Inquiries"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness Probe",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness Probe",
        "responses": {
          "200": {
            "description": "Service is ready to handle traffic",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ready"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service or Database Unavailable"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register New User",
        "description": "Self-registration for drivers (auto-approved) and business operators (pending approval). Disallowed for administrative roles.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "403": {
            "description": "Role cannot be self-assigned"
          },
          "409": {
            "description": "Email already registered"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Authenticate User",
        "description": "Validates email and argon2id password hash. Returns access and refresh token pair.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          },
          "403": {
            "description": "Account pending approval or suspended"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Rotate Refresh Token",
        "description": "Rotates refresh token atomically with token theft / reuse detection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refresh_token"
                ],
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refreshed token pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or reused refresh token"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Revoke Refresh Token",
        "description": "Revokes the specified refresh token session. Idempotent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refresh_token"
                ],
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully logged out"
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get Current User Profile",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current authenticated user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "users"
        ],
        "summary": "Update User Profile",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/zones": {
      "get": {
        "tags": [
          "zones"
        ],
        "summary": "List Parking Zones",
        "parameters": [
          {
            "name": "city_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "parking",
                "loading",
                "mixed"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of zones",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZonePage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/zones/{zone_id}": {
      "get": {
        "tags": [
          "zones"
        ],
        "summary": "Get Zone Details",
        "parameters": [
          {
            "name": "zone_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Zone record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneOut"
                }
              }
            }
          },
          "404": {
            "description": "Zone not found"
          }
        }
      }
    },
    "/api/v1/zones/{zone_id}/live": {
      "get": {
        "tags": [
          "zones"
        ],
        "summary": "Get Live Telemetry Summary",
        "description": "Returns real-time occupancy counts, crowd level, data state (LIVE, STALE, UNAVAILABLE), and freshness.",
        "parameters": [
          {
            "name": "zone_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Live zone occupancy and crowd telemetry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneLiveSummaryOut"
                }
              }
            }
          },
          "404": {
            "description": "Zone not found"
          }
        }
      }
    },
    "/api/v1/parking-reservations": {
      "post": {
        "tags": [
          "parking-reservations"
        ],
        "summary": "Create Parking Reservation",
        "description": "Transactionally books a regular bay with PostgreSQL exclusion constraint overlap protection and automatic ascending bay assignment.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParkingReservationCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reservation created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationOut"
                }
              }
            }
          },
          "409": {
            "description": "Booking overlap or slot unavailable"
          }
        }
      },
      "get": {
        "tags": [
          "parking-reservations"
        ],
        "summary": "List Parking Reservations",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ReservationStatus"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User reservation history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/parking-reservations/{reservation_id}/status": {
      "patch": {
        "tags": [
          "parking-reservations"
        ],
        "summary": "Transition Reservation Status",
        "description": "Transitions a reservation through validated lifecycle state machine (checked_in, in_progress, completed, cancelled). Enforces cancellation cutoffs and check-in grace periods.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "reservation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated reservation state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationOut"
                }
              }
            }
          },
          "409": {
            "description": "Invalid state transition, cutoff exceeded, or grace window closed"
          }
        }
      }
    },
    "/api/v1/loading/zones": {
      "get": {
        "tags": [
          "loading"
        ],
        "summary": "List Commercial Loading Zones",
        "responses": {
          "200": {
            "description": "List of zones supporting commercial loading",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ZoneOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/loading/zones/{zone_id}/slots": {
      "get": {
        "tags": [
          "loading"
        ],
        "summary": "Get 30-Minute Loading Slot Availability",
        "parameters": [
          {
            "name": "zone_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "vehicle_category",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/VehicleCategory"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available loading slots",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SlotOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/loading/reservations": {
      "post": {
        "tags": [
          "loading"
        ],
        "summary": "Book Commercial Loading Bay",
        "description": "Restricted to verified business operators. Enforces half-open interval overlap protection on commercial delivery bays.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoadingReservationCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Loading reservation confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationOut"
                }
              }
            }
          },
          "409": {
            "description": "Booking overlap or slot collision"
          }
        }
      }
    },
    "/api/v1/availability/estimate": {
      "post": {
        "tags": [
          "availability"
        ],
        "summary": "Estimate Arrival-Time Parking Probability",
        "description": "Calculates the arrival-time probability of finding at least one available regular bay using binomial nowcasting (<=15m) or time-series forecast center/sigma sampling (up to 168h) over 2,000 Monte Carlo runs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AvailabilityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Arrival availability prediction output",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityOut"
                }
              }
            }
          },
          "404": {
            "description": "Zone not found"
          }
        }
      }
    },
    "/api/v1/availability/compare": {
      "post": {
        "tags": [
          "availability"
        ],
        "summary": "Compare Multiple Zones / Arrival Windows",
        "description": "Runs Monte Carlo availability simulation on multiple candidate zones or arrival times, returning ranked options ordered by highest availability probability.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked availability comparison",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommendations": {
      "post": {
        "tags": [
          "recommendations"
        ],
        "summary": "Get Intelligent Parking Recommendations",
        "description": "Ranks nearby candidate zones by weighted composite score: availability probability, walking distance from destination, price, and crowd congestion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recommended parking options",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List Users (Admin)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "suspended",
                "rejected"
              ]
            }
          },
          {
            "name": "role",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Role"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users/{user_id}/status": {
      "patch": {
        "tags": [
          "admin"
        ],
        "summary": "Update User Status (Approve/Suspend)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "approved",
                      "suspended",
                      "rejected"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/occupancy": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Generate Historical Occupancy Report",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "zone_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aggregated occupancy metrics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportOccupancyOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit/logs": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Query Immutable Audit Trail",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "entity_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entity_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actor_user_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit trail records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditLogRowOut"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "ParkSMART HS256 JWT Access Token"
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "driver",
          "business_operator",
          "field_operator",
          "municipal_admin",
          "system_admin",
          "analyst",
          "device"
        ]
      },
      "ReservationStatus": {
        "type": "string",
        "enum": [
          "pending",
          "confirmed",
          "checked_in",
          "in_progress",
          "completed",
          "cancelled",
          "no_show",
          "expired"
        ]
      },
      "VehicleCategory": {
        "type": "string",
        "enum": [
          "two_wheeler",
          "car",
          "auto_rickshaw",
          "lcv",
          "hcv",
          "bus"
        ]
      },
      "CrowdLevel": {
        "type": "string",
        "enum": [
          "low",
          "moderate",
          "high",
          "very_high",
          "unknown"
        ]
      },
      "DataState": {
        "type": "string",
        "enum": [
          "live",
          "stale",
          "unavailable",
          "unknown"
        ]
      },
      "PredictionStatus": {
        "type": "string",
        "enum": [
          "ok",
