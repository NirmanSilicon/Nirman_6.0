<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Sockets to the laptop only (127.0.0.1 over USB via adb reverse, D9). Android requires this
         permission for any socket; Saarthi uses no internet service (PRD rule 7.3). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Press-and-hold speech, recognised on the phone (no audio leaves it). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Safety SOS (D47): an SMS to the trusted contact with the approximate location, after a fall and
         an unanswered "Are you OK?". SMS and GPS work without internet. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Guidance cues by vibration (PRD 5.3). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 11+ package visibility: lets the app bind the system text-to-speech engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Saarthi"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
