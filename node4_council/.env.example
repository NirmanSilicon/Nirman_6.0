# NanoShield Node 4 (Multi-Agent Council) configuration template.
# Copy to .env (gitignored) and edit:   cp .env.example .env
# Never put real credentials in this file.

# --- Node 4 server ------------------------------------------------------------
# 0.0.0.0 listens on every interface (localhost, LAN and VPN). Use 127.0.0.1 to
# accept connections from this machine only. There is no authentication, so only
# expose Node 4 on a trusted network.
NODE4_HOST=0.0.0.0
NODE4_PORT=8004
# Comma-separated browser origins allowed by CORS, or * for any origin.
# Example: http://localhost:3000,http://192.168.1.30:5173
CORS_ALLOW_ORIGINS=*
LOG_LEVEL=INFO

# --- Graph-RAG (Node 3) -------------------------------------------------------
# true  = serve mocks/sample_graph_rag.json (no Neo4j needed)
# false = query the live Neo4j instance below
USE_MOCK_GRAPH_RAG=true
NODE3_NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
# Hard upper limit for one Graph-RAG lookup. On expiry the safe fallback is used.
NODE3_QUERY_TIMEOUT_MS=1500

# --- LLM ----------------------------------------------------------------------
# mock   = offline deterministic engineering reasoning
# ollama = local Ollama writes the Yield and Throughput narratives. Actuator
#          parameters and safety checks are always deterministic.
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Per-call limit. After one failed call the rest of that run is deterministic.
OLLAMA_TIMEOUT_MS=15000

# --- Multi-machine networking -------------------------------------------------
# Single machine (default): nothing to change.
#
# Option A - same LAN (all nodes on one Wi-Fi / switch)
#   1. Find each machine's LAN IP:
#        macOS:   ipconfig getifaddr en0
#        Linux:   hostname -I
#        Windows: ipconfig
#   2. Keep NODE4_HOST=0.0.0.0 and set, using Node 3's LAN IP:
#        USE_MOCK_GRAPH_RAG=false
#        NODE3_NEO4J_URI=bolt://192.168.1.20:7687
#        OLLAMA_BASE_URL=http://127.0.0.1:11434   (or the Ollama host's LAN IP)
#   3. Other nodes reach Node 4 on its LAN IP:
#        POST http://192.168.1.40:8004/api/v1/trigger-council
#        WS   ws://192.168.1.40:8004/ws/recommendations
#   4. Allow inbound TCP 8004 (Node 4) and 7687 (Node 3) through the firewalls.
#
# Option B - Tailscale or ZeroTier (machines on different networks)
#   1. Join every machine to the same tailnet / ZeroTier network.
#   2. Find the virtual IPs:
#        Tailscale: tailscale ip -4          (usually 100.x.y.z)
#        ZeroTier:  zerotier-cli listnetworks (assigned address, e.g. 10.147.x.y)
#   3. Keep NODE4_HOST=0.0.0.0 and set, using Node 3's virtual IP:
#        USE_MOCK_GRAPH_RAG=false
#        NODE3_NEO4J_URI=bolt://100.101.102.103:7687
#   4. Other nodes reach Node 4 on its virtual IP:
#        POST http://100.64.10.4:8004/api/v1/trigger-council
#        WS   ws://100.64.10.4:8004/ws/recommendations
#   5. VPN links add latency; if lookups fall back too often, raise
#        NODE3_QUERY_TIMEOUT_MS=3000
#
# The IP addresses above are examples. Replace them with your own.
