# CyberGuard MSME — Recommended Nginx Hardening Block for {{ domain }}
# Place inside your HTTPS server { ... } block, then run: sudo nginx -t && sudo systemctl reload nginx
{% if "SERVER_BANNER_LEAK" in codes %}

# Hide Nginx version number from HTTP response headers
server_tokens off;
{% endif %}
{% if "MISSING_HSTS" in codes or "WEAK_HSTS" in codes %}

# Enforce HTTPS for 1 year (HSTS)
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
{% endif %}
{% if "MISSING_CSP" in codes %}

# Restrict script/style sources to mitigate XSS (adjust trusted CDNs if used)
add_header Content-Security-Policy "default-src 'self'; object-src 'none'; frame-ancestors 'self';" always;
{% endif %}
{% if "MISSING_X_FRAME_OPTIONS" in codes %}

# Prevent Clickjacking inside external iframes
add_header X-Frame-Options "SAMEORIGIN" always;
{% endif %}
{% if "MISSING_X_CONTENT_TYPE_OPTIONS" in codes %}

# Disable browser MIME-type sniffing
add_header X-Content-Type-Options "nosniff" always;
{% endif %}
{% if "MISSING_REFERRER_POLICY" in codes %}

# Limit leaked URL paths on outbound clicks
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
{% endif %}
{% if "EXPOSED_SENSITIVE_FILE" in codes %}

# Block public access to hidden dotfiles (.env, .git, .htaccess)
location ~ /\.(?!well-known).* {
    deny all;
    return 404;
}
{% endif %}
{% if "DEPRECATED_TLS" in codes %}

# Allow only modern TLS 1.2 and TLS 1.3 protocols
ssl_protocols TLSv1.2 TLSv1.3;
{% endif %}
{% if "NO_HTTPS_REDIRECT" in codes %}

# Add this separate port-80 server block to redirect all HTTP traffic to HTTPS:
# server {
#     listen 80;
#     server_name {{ domain }};
#     return 301 https://$host$request_uri;
# }
{% endif %}