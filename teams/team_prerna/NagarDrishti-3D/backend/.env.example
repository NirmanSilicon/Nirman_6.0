# Backend Private Configuration (NEVER expose in frontend or commit to Git)
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

PYTHON_SERVICE_URL=http://localhost:8000

# Legacy names remain supported when using older Supabase anon/service_role keys.
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# One-time secret token used ONLY to promote the first verified admin account.
# Generate a strong random string (e.g. openssl rand -hex 32) and remove after setup.
ADMIN_BOOTSTRAP_TOKEN=

# Optional Copernicus Data Space Ecosystem credentials for Sentinel-2 imagery
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
